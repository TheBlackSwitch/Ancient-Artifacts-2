    // Some nice to have snippets
    "Return And Run": {
        "prefix": [
            ">> return run"
        ],
        "body": "run return run",
        "description": "A run return run loop",
        "scope": "mcfunction,json"
    },
    "If else statement": {
        "prefix": [
            ">> ifelse"
        ],
        "body": [
            "execute if ${1|score,predicate,entity,data,items,function,block,blocks,biome,dimension,loaded|} ${2} run return run ${3:<on_true>}",
            "${4:<on_false>}"
        ],
        "description": "An if else statement",
        "scope": "mcfunction,json"
    },
    "comment_heading": {
        "prefix": ">> comment heading",
        "body": [
            "#-------------------------------------------------------",
            "## ${1:<comment>}",
            "#-------------------------------------------------------$2"
        ]
    },
    "comment_subheading": {
        "prefix": ">> comment subheading",
        "body": [
            "# ===== ${1:<comment>} =====$2"
        ]
    },
